<?xml version="1.0" encoding="utf-8"?>
<!--
  Keeps the daily-reminder notification icon from being removed by the release
  resource shrinker (Flutter enables R8 + shrinkResources for release builds).

  This drawable is referenced only by name string at runtime
  (NotificationService.scheduleDailyReminder: icon: 'ic_stat_reminder'), never
  via R.drawable, so the shrinker marks it unreachable and strips it from the
  APK. When that happens, zonedSchedule throws PlatformException(invalid_icon)
  and the daily reminder toggle silently fails to turn on (only in release
  builds).
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_reminder" />
